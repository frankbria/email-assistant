# .env.example

# URL to your FastAPI backend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# MongoDB holding the Better Auth collections (user, session, account, verification)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=email_assistant

# Better Auth: generate with `openssl rand -base64 32`; required in production
BETTER_AUTH_SECRET=
# Public URL of this Next.js app
BETTER_AUTH_URL=http://localhost:3000
