# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=email_assistant
MONGODB_TEST_URI=mongodb://localhost:27017/
MONGODB_TEST_DB=email_assistant-test

# === CORS (for local frontend access) ===
FRONTEND_ORIGIN=http://localhost:3000

# === Environment mode ===
API_ENVIRONMENT=development

# === OpenAI / AI provider credentials ===
OPENAI_API_KEY=sk-...
OPENAI_API_MODEL=gpt-3.5-turbo
USE_AI_CONTEXT=true
# AI summarization toggle
USE_AI_SUMMARY=false
# AI actions toggle
USE_AI_ACTIONS=false

# === Logging ===
LOG_LEVEL=info

# === Auth ===
# Public URL of the Next.js app (Better Auth): JWT issuer/audience; JWKS at <url>/api/auth/jwks
BETTER_AUTH_URL=http://localhost:3000
# Optional: fetch the JWKS from another address (e.g. the Compose network)
# BETTER_AUTH_JWKS_URL=http://frontend:3000/api/auth/jwks
