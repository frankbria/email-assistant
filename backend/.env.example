# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=email_assistant
MONGODB_TEST_URI=mongodb://localhost:27017/
MONGODB_TEST_DB=email_assistant-test

# === CORS (for local frontend access) ===
FRONTEND_ORIGIN=http://localhost:3200

# === Environment mode ===
API_ENVIRONMENT=development

# === AI provider ===
# AI_PROVIDER, AI_MODEL, SYNC_POLL_SECONDS and FIRST_CONNECT_DAYS are defaults: the settings screen overrides them
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# === Sync ===
# Seconds between inbox polls per plugin; plugins with `push` are polled sooner
SYNC_POLL_SECONDS=120
# On first connect, only mail from this many recent days is synced; older mail is left alone
FIRST_CONNECT_DAYS=14
# Optional cap on AI calls per month; unset = no cap. At the cap new mail goes to the owner (ask-owner)
# AI_MONTHLY_CAP=1000
# The readable per-verb permissions file (autonomous / ask / never_auto). The app keeps it in sync with the
# settings screen and rewrites it from the database when it's missing.
PERMISSIONS_FILE=permissions.yaml
# The calibration test set: real mail from "Calibrate" with your reactions. Keep it local (calibration/ is never committed).
TEST_SET_FILE=calibration/test_set.jsonl

# === Logging ===
LOG_LEVEL=info

# === Auth ===
# Public URL of the Next.js app (Better Auth): JWT issuer/audience; JWKS at <url>/api/auth/jwks
BETTER_AUTH_URL=http://localhost:3200
# Optional: fetch the JWKS from another address (e.g. the Compose network)
# BETTER_AUTH_JWKS_URL=http://frontend:3200/api/auth/jwks
