# Proton plugin + watchdog settings. Keep this file private (it holds the Bridge password).
MAILBOX_ACCOUNT=you@proton.me
MAILBOX_USERNAME=you@proton.me
MAILBOX_PASSWORD=
MAILBOX_CA_CERT_PATH=
# MAILBOX_TLS=starttls
# HTTP mode (the app runs on another machine): this machine's Tailscale IP and a token
MAILBOX_HTTP_HOST=
MAILBOX_HTTP_TOKEN=
# Watchdog status endpoint token, and how to restart Bridge (JSON list)
MAILBOX_WATCHDOG_TOKEN=
MAILBOX_BRIDGE_RESTART_COMMAND=
