# Proton plugin + watchdog settings. Keep this file private (it holds the Bridge password).
MAILBOX_ACCOUNT=you@proton.me
MAILBOX_USERNAME=you@proton.me
MAILBOX_PASSWORD=
MAILBOX_CA_CERT_PATH=
# MAILBOX_TLS=starttls
# HTTP mode (the app runs on another machine): this machine's Tailscale IP and a token
MAILBOX_HTTP_HOST=
MAILBOX_HTTP_TOKEN=
# Watchdog status endpoint token, and how to start Bridge (JSON list). The command must start
# Bridge in the background and return; one still running after 60 s is stopped. Windows:
# ["powershell", "-NoProfile", "-Command", "Start-Process -WindowStyle Hidden -FilePath 'C:\\Program Files\\Proton AG\\Proton Mail Bridge\\proton-bridge.exe' -ArgumentList '--no-window'"]
MAILBOX_WATCHDOG_TOKEN=
MAILBOX_BRIDGE_RESTART_COMMAND=
# Optional: other local services the watchdog starts when their loopback port is down (JSON)
# MAILBOX_COMPANION_START_COMMANDS={"8099": ["schtasks", "/Run", "/TN", "\\My Gateway"]}
