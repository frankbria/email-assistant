# Copy to .env next to docker-compose.yml. Never commit .env.

# MongoDB: Atlas connection string (stored mail then lives in Atlas, off your machines),
# or mongodb://mongo:27017 together with `docker compose --profile local-mongo up`.
MONGODB_URI=
MONGODB_DB=email_assistant

# Public URLs as the browser sees them (tailnet hostname or IP plus port).
# PUBLIC_API_BASE is baked into the frontend image at build time.
PUBLIC_API_BASE=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Interface the ports listen on: the host's Tailscale IP (`tailscale ip -4`).
# Default 127.0.0.1. Never 0.0.0.0: Docker's published ports bypass UFW.
BIND_ADDRESS=127.0.0.1

# Host ports (the host is shared: check `ss -ltn` for conflicts first).
BACKEND_PORT=8000
FRONTEND_PORT=3000
